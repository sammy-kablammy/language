x: int = 0
while x < 400 {
    if x >= 100 {
        if x >= 200 {
            if x >= 300 {
                if x > 400 {
                    break
                }
                else {
                    x = x + 1
                }
            }
            else {
                x = x + 1
            }
        }
        else {
            x = x + 1
        }
    }
    else {
        x = x + 1
    }
}
