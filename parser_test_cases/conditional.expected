x: int = 3
y: int = 5
if x < y {
    if y - x > 2 {
        return thing
    }
    else {
        if y == 5 {
            return stuff
        }
        else {
            if y == 6 {
                return other_stuff
            }
        }
    }
    if condition {
        return this
    }
    else {
        return that
    }
}
else {
    return jawn
}
